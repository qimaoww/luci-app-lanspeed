#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

NAME="lanspeedd"
PROG="/usr/sbin/lanspeedd"
TC="/sbin/tc"
LANSPEED_TC_OWNER="lanspeed"
LANSPEED_TC_PREF="49152"
LANSPEED_TC_HANDLE="0x1eed"
LANSPEED_TC_EARLY_PREF="1"
LANSPEED_TC_EARLY_HANDLE="0x1eee"

config_ifaces() {
	config_get ifnames "$1" ifname
	for ifname in $ifnames; do
		printf '%s\n' "$ifname"
	done

	config_get includes "$1" interface_include
	for ifname in $includes; do
		printf '%s\n' "$ifname"
	done
}

lanspeed_tc_filter_owned() {
	section="$1"
	if printf '%s\n' "$section" | grep -q "pref $LANSPEED_TC_PREF"; then
		printf '%s\n' "$section" | grep -q "handle $LANSPEED_TC_HANDLE" || return 1
	elif printf '%s\n' "$section" | grep -q "pref $LANSPEED_TC_EARLY_PREF"; then
		printf '%s\n' "$section" | grep -q "handle $LANSPEED_TC_EARLY_HANDLE" || return 1
	else
		return 1
	fi
	printf '%s\n' "$section" | grep -F -q "$LANSPEED_TC_OWNER" || return 1
	printf '%s\n' "$section" | grep -E -q 'lanspeed_ingres|lanspeed_egress' || return 1
	return 0
}

lanspeed_tc_filter_sections() {
	dev="$1"
	direction="$2"
	$TC filter show dev "$dev" "$direction" 2>/dev/null | awk '
		/^filter / {
			if (entry != "") print entry;
			entry = $0;
			next;
		}
		{
			if (entry != "") entry = entry " " $0;
		}
		END {
			if (entry != "") print entry;
		}
	'
}

lanspeed_tc_filter_present() {
	dev="$1"
	direction="$2"
	pref="$3"
	handle="$4"
	sections=$(lanspeed_tc_filter_sections "$dev" "$direction")
	while IFS= read -r filter; do
		if lanspeed_tc_filter_owned "$filter" &&
		   printf '%s\n' "$filter" | grep -q "pref $pref" &&
		   printf '%s\n' "$filter" | grep -q "handle $handle"; then
			return 0
		fi
	done <<EOF
$sections
EOF
	return 1
}

lanspeed_tc_delete_owned() {
	dev="$1"
	direction="$2"
	pref="$3"
	handle="$4"
	logger -t "$NAME" "removing owned tc filter dev=$dev direction=$direction pref=$pref handle=$handle"
	if $TC filter del dev "$dev" "$direction" protocol all pref "$pref" handle "$handle" bpf 2>/dev/null; then
		return 0
	fi
	# Aya may release the link between `show` and `del` while procd is
	# completing shutdown. Treat an already-absent owned filter as success;
	# warn only when the kernel still reports the exact owned identity.
	if lanspeed_tc_filter_present "$dev" "$direction" "$pref" "$handle"; then
		logger -p daemon.warn -t "$NAME" "owned tc filter cleanup failed dev=$dev direction=$direction pref=$pref handle=$handle"
	fi
	return 0
}

cleanup_lanspeed_tc_filters_on_dev() {
	dev="$1"
	[ -n "$dev" ] || return 0
	[ -x "$TC" ] || return 0

	for direction in ingress egress; do
		sections=$(lanspeed_tc_filter_sections "$dev" "$direction")

		printf '%s\n' "$sections" | while IFS= read -r filter; do
			if lanspeed_tc_filter_owned "$filter"; then
				if printf '%s\n' "$filter" | grep -q "pref $LANSPEED_TC_EARLY_PREF"; then
					lanspeed_tc_delete_owned "$dev" "$direction" "$LANSPEED_TC_EARLY_PREF" "$LANSPEED_TC_EARLY_HANDLE"
				else
					lanspeed_tc_delete_owned "$dev" "$direction" "$LANSPEED_TC_PREF" "$LANSPEED_TC_HANDLE"
				fi
			fi
		done
	done
}

cleanup_lanspeed_tc_filters() {
	config_load lanspeed
	config_foreach config_ifaces lanspeed | sort -u | while IFS= read -r ifname; do
		cleanup_lanspeed_tc_filters_on_dev "$ifname"
	done
}

start_service() {
	# A package upgrade can force-kill an older daemon before procd reaches
	# service_stopped(). Reclaim only the exact reserved lanspeed identities
	# before loading the new object so stale program IDs cannot block startup.
	cleanup_lanspeed_tc_filters
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	cleanup_lanspeed_tc_filters
}

reload_service() {
	if ubus call lanspeed reload >/dev/null 2>&1; then
		return 0
	fi
	# NSS reload is transactional: the old daemon and its proven queues still
	# own the live dataplane when the RPC fails.  Restarting here would run the
	# stop/start cleanup against that owner and can remove hooks underneath the
	# failed transaction.  Keep the intact runtime; procd respawn still handles
	# an actually exited daemon.  x86 retains its historical restart fallback.
	if [ -d /sys/module/lanspeed_nss_control ]; then
		logger -p daemon.warn -t "$NAME" "transactional NSS reload failed; preserving current dataplane"
		return 1
	fi
	restart
}

service_triggers() {
	procd_add_reload_trigger "lanspeed" "network"
	procd_add_interface_trigger "interface.*" "lan" /etc/init.d/lanspeedd reload
}
